# Add this value in Vercel: Project Settings > Environment Variables.
# Use the pooled PostgreSQL connection string from your Vercel Marketplace database, Supabase, Neon, or another PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required for the protected admin portal. Use a strong, unique password and
# a random secret with at least 32 characters. Never commit a real .env file.
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
